#!/bin/sh
# Entware init script: наблюдатель резервного egress (Amnezia/WireGuard -> Xray).
# Запускается ПОСЛЕ S93 (Xray) и S94 (Susanin.Keenetic): имя S96 > S94.
# Install as /opt/etc/init.d/S96susanin-failover and make executable.
# Test: /opt/etc/init.d/S96susanin-failover start|stop|restart|status

SH=/opt/susanin/tools/egress-failover.sh
PIDF=/opt/susanin/var/failover.pid

is_running() {
    [ -f "$PIDF" ] || return 1
    _p=$(cat "$PIDF" 2>/dev/null || true)
    case "$_p" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$_p/cmdline" ] || return 1
    tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null | grep -q 'egress-failover.sh' || return 1
    return 0
}

start() {
    [ -x "$SH" ] || { echo "susanin-failover: нет $SH — пропуск"; return 0; }
    if is_running; then echo "susanin-failover: уже запущен"; return 0; fi
    mkdir -p /opt/susanin/var
    "$SH" run >/dev/null 2>&1 &
    echo $! > "$PIDF"
    echo "susanin-failover: started (pid $(cat "$PIDF"))"
}

stop() {
    if ! is_running; then rm -f "$PIDF"; echo "susanin-failover: не запущен"; return 0; fi
    _p=$(cat "$PIDF" 2>/dev/null)
    kill -TERM "$_p" 2>/dev/null || true
    _i=0
    while [ "$_i" -lt 5 ] && is_running; do sleep 1; _i=$((_i + 1)); done
    is_running && kill -9 "$_p" 2>/dev/null || true
    rm -f "$PIDF"
    echo "susanin-failover: stopped"
}

status() {
    if is_running; then echo "susanin-failover: RUNNING (pid $(cat "$PIDF"))"; else echo "susanin-failover: stopped"; fi
    [ -x "$SH" ] && "$SH" status
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
