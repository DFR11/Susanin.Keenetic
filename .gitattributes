# Normalize line endings: scripts/config must stay LF (busybox sh, WSL builds).
*.sh            text eol=lf
Makefile        text eol=lf
Dockerfile*     text eol=lf
*.conf          text eol=lf
# init-скрипты (S93xray-tproxy, S94susanin, S95susanin-web, S96susanin-failover):
# общий шаблон S9*susanin не покрывал их, а busybox sh падает на CRLF.
init/**         text eol=lf
S9*susanin      text eol=lf
# скрипты пакета .ipk (control-скрипты opkg исполняются как sh)
opkg/*          text eol=lf
# исходники и статика
*.c             text eol=lf
*.h             text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.yml           text eol=lf
