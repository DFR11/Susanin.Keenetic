# failover.conf — настройки резервного egress (Amnezia/WireGuard -> Xray).
# Читается /opt/susanin/tools/egress-failover.sh. Отдельный файл: движок его
# не разбирает, поэтому ключи не теряются при `susanin-agent config set` и
# перезаписи susanin.conf (`susanin.sh install`/`setup`).
# Файл необязателен — без него действуют значения по умолчанию (см. ниже).

# 1 = наблюдатель работает; 0 = выключен (режим меняете вручную в панели).
enable=1

# Основной канал (интерфейс туннеля). Пусто = первый интерфейс из
# egress_interface в susanin.conf.
primary=

# Адреса для пробы ЧЕРЕЗ основной интерфейс (SO_BINDTODEVICE). Через запятую
# или пробелами; достаточно ответа от любого.
probe=1.1.1.1 8.8.8.8

# Период проверки, секунды.
interval=10

# Столько неудач подряд -> уходим на Xray (tproxy).
miss=3

# Столько удач подряд -> возвращаемся на основной канал.
recover=6

# Пауза после переключения (антидребезг), секунды.
cooldown=60

# Не трогать режим первые N секунд после старта (тоннель поднимается не сразу).
boot_grace=60

# 1 = не гасить Xray, когда основной канал работает (быстрее возврат ценой RAM).
keep_xray=0

# init-скрипт Xray.
xray_init=/opt/etc/init.d/S93xray-tproxy

# Сколько секунд ждать, пока Xray займёт порт tproxy, прежде чем отменить
# переключение (при медленном старте увеличьте).
xray_wait=25
